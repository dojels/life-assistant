# 复制为 .env 后填写。.env 已被 .gitignore 排除,不要提交。
#
# 离线开发/验收:把 LA_LLM_PROVIDER 设为 fake,即可在没有任何密钥的情况下
# 跑通 CLI、时间上下文注入、以及 S1–S7 全部验收场景。
LA_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
LA_BASE_URL=https://api.deepseek.com
# 实测 GET /models 返回:deepseek-flash、deepseek-v4-pro
LA_MODEL=deepseek-flash
LA_REASONER_MODEL=deepseek-flash
# 思考强度:low | high | max(官方默认 high)。带 tools 时思维链必须回传,代码已处理。
LA_REASONING_EFFORT=high
LA_TIMEZONE=Asia/Shanghai
LA_REQUEST_TIMEOUT=180
LA_MAX_RETRIES=3
# --- M6 安全开关 ---------------------------------------------------------
# 一键停止写入:所有写工具直接返回 READ_ONLY,读操作照常。
# 想"看看它在干什么但别动我的数据"时打开;平时留 0。
LA_READ_ONLY=0
# --- M7 写入方式开关 -----------------------------------------------------
# 1(默认)= **直写**:领域写入直接执行,不再等用户点确认。
#            安全网是"写入回执 + 一键撤销"(ops_receipts),五个域共用一套。
# 0        = 老行为:risk=confirm 的操作停在待确认状态,由用户手动放行。
# 想彻底不许它写,用上面的 LA_READ_ONLY(那是关闸,这是换一种确认方式)。
LA_DIRECT_WRITE=1
# 数据目录硬上限(MB)。超过时 --guardrails 的 G08 会报失败。
LA_DATA_QUOTA_MB=512
# 复习排程引擎:fixed | fsrs(默认 fixed;先验证孩子愿不愿意用,再换 FSRS)
LA_SRS_ENGINE=fixed
# 错题复习的后台心跳(只有 python -m la --web 会启动它):每分钟看一眼"到点该推的错题复习"。
# 0 = 关掉。它是确定性调度器,不调用模型 —— 关不关都不影响页面读取与手工录入。
LA_TICKER=1
# 会话 ID(多会话时用;默认 default)
LA_SESSION_ID=default
# --- M12 联网开关 --------------------------------------------------------
# ⚠️ **默认关**:联网 = 数据出境,检索词会发给搜索服务。
# ⭐ 这里只是**出厂默认值** —— 平时不用改它:聊天页右上角有「联网」按钮,
#    点一下就切,存在库里(sys_settings)、**不重启**、微信入口同时生效。
#    按钮点过之后以按钮为准(见 ops/settings_store.py 的三层优先级)。
# 关着的时候 web_search / web_fetch **照样在工具清单里**,调用时如实回一句
# "联网是关着的",而不是让模型以为它不能联网。
LA_WEB_ENABLED=0
# 搜索与抓取都走 **DeepSeek 官方接口**(与对话同一个 key,2026-10-18 D141 起):
#   Search: POST /v1/tools/search —— 自研搜索引擎,**不烧 token**,按成功请求计费
#           (5 元 / 1000 次 = 0.005 元/次);每条结果给 标题 + 链接 + 摘要 + 日期 + 权威度。
#   Fetch : POST /v1/tools/fetch  —— 返回 **Markdown 正文**,反爬/编码/正文提取由对方处理。
# ⚠️ 旧路子(服务端工具塞进对话)一次 query 要烧 4888 输入 + 616 输出 token(约 0.014 元),
#    而且只给标题链接 —— 已经换掉了。想知道"联网花了多少":轨迹页 → 使用报表。
# 搜索:deepseek | none(只保留抓取,自己打开已知链接)
LA_WEB_SEARCH_PROVIDER=deepseek
# 抓取:deepseek(官方,推荐)| local(本机 httpx,带 SSRF 闸 —— 唯一**不把链接发出去**的选项)
LA_WEB_FETCH_PROVIDER=deepseek
# --- 设置页的密钥通道(2026-10-23 起)------------------------------------
# 设置页允许填 LLM / 语音的密钥。**非 HTTPS 且非回环**的连接默认会被拒绝 ——
# 密钥与 PIN 明文过网等于裸奔。临时在内网用 HTTP 调试,才打开这个逃生开关:
# LA_ALLOW_INSECURE_SECRETS=1
#
# --- Web 的 Host 白名单(防 DNS rebinding)--------------------------------
# 默认放行:localhost / 127.0.0.1 / ::1 / **任何 IP 字面量**(局域网用 IP 访问是正常用法)。
# 要用主机名/自定义域名访问(例如 http://desktop-abc:8765),把名字写在这里(逗号分隔)。
# ⚠️ 只写域名,不带端口,例如: LA_WEB_HOSTS=desktop-abc,life.lan
# LA_WEB_HOSTS=
# --- 云端部署(WeChat 主通道 + 家里浏览器)--------------------------------
# 域名必须写进 LA_WEB_HOSTS,否则 Host 守卫会 403。
# 首次安装在云端没有“本机浏览器”:设一个一次性口令,打开 /setup?token=<口令>;
# 装完(拿到恢复码)就把它从环境变量里删掉。不设则仍然只允许本机 /setup。
# LA_BOOTSTRAP_TOKEN=
# 反向代理(nginx/caddy)要转发 X-Forwarded-Proto;登录 cookie 靠它判断 Secure。
#
# --- 手机订阅日历的公网地址(2026-10-31)----------------------------------
# 手机上不装 Tailscale 也能订阅日历:云端 nginx 只在公网放行 **/calendar/ics 一条只读入口**
# (其余路径一律 444)。这里填"手机该用的那个地址",页面上的复制/订阅按钮就用它。
# ⚠️ 这是 HTTP 明文:token 在链接里,链接泄露了就点「重置订阅链接」换一条。
# ⚠️ 不填 = 页面只给当前访问地址(内网/Tailscale),手机连不上。
# LA_CALENDAR_PUBLIC_BASE=http://203.0.113.10:8765
# --- iPhone 健康同步的地址(2026-11-11,D181)------------------------------
# 快捷指令/第三方 App 往 POST /api/health/sync 推数据。手机该用的地址写这里;
# 不填 = 回落到 LA_CALENDAR_PUBLIC_BASE(同一个 8765 入口),再没有就用当前访问地址。
# ⚠️ 这是**写**入口:nginx 要单独放行 /api/health/sync,且它仍是 HTTP 明文。
#    口令在「健康 → 同步」页生成,只走 Authorization: Bearer 请求头(不认 URL 参数)。
# LA_HEALTH_PUBLIC_BASE=http://203.0.113.10:8765
# --- 主智能体的工具预算 --------------------------------------------------
# 口径来自「云朵辅助培训智能体」(已上线那个项目的现网值):到顶**撤掉工具、按现有结果成文**,
# 并把原因写进用户可见的步骤账本 —— 不会无限打转,也不会静默截断。
# ⚠️ 两个数要**一起**调:每轮至少发一次调用,只提轮数会被调用数先掐掉。
# ⚠️ 它们只管**回答阶段**模型自己发起的调用;QA(2)/ARCH(3)/总步数(6)是自动检索的闸,不受影响。
LA_AGENT_MAX_ITERS=30
LA_AGENT_MAX_TOOL_CALLS=40
# 单轮墙钟上限(秒)。**0 = 不限**;默认 900(15 分钟,D105 定的)。
# 为什么要有:云朵是网页端,用户能看着账本跑;我们主通道是微信 ——
# 发一条等一条,中间没有账本也没有停止按钮。到点走"收回工具、按现有结果成文",不是报错。
# ⚠️ 等用户回答(ask_user / category_create)的时间**不计入**这个额度。
LA_AGENT_MAX_TURN_SEC=900
# 工具瞬时错误(超时/连接类)**自动重试一次**(照云朵 _TRANSIENT_RETRY=1)。
# ⚠️ 只对只读工具重试:写类重试有幂等风险。0 = 关掉。
LA_TOOL_TRANSIENT_RETRY=1
# 上下文超过这个规模就**放弃重试**,如实报错(照云朵 40000 那条)。
# 理由:重试要重新 prefill 一遍大 prompt,既慢又大概率同样卡住。0 = 不限。
LA_STREAM_RETRY_MIN_CTX=40000

# 凭据读取顺序:真实环境变量 > settings.yaml > .env(本文件)。
# settings.yaml 是可选的,格式就是最简单的 key: value(见 ops/credentials.py)。
